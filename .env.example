# Local Cloudflare Worker and Neon configuration.
# Keep actual credentials in a private .dev.vars file (ignored by Git) or Cloudflare secrets.

# Neon pooled connection string for the Strap application database
DATABASE_URL=

# Public application origin (no trailing slash)
APP_URL=

# Generate with: node scripts/gen-secrets.js
APP_SECRET=
APP_ENCRYPTION_KEY=
CRON_SECRET=

# Flutterwave API and webhook settings
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET_HASH=

# Neon Managed Better Auth endpoint (Neon Console > Auth > Configuration)
NEON_AUTH_BASE_URL=

# Needed only for non-auth transactional email (support and billing notices)
RESEND_API_KEY=
EMAIL_FROM=Strap <onboarding@resend.dev>

# Optional SMS for contact verification
TERMII_API_KEY=
TERMII_SENDER_ID=Strap
TERMII_BASE_URL=https://api.ng.termii.com

# Optional configuration
SUPPORT_EMAIL=
BASE_DOMAIN=strap.store
DEV_SHOW_CODES=false

# Existing Vercel-only custom-domain automation; unused on Cloudflare
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
